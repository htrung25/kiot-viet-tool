<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.Features.Auth"
             x:Class="KiotVietTool.Desktop.Features.Auth.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
    <ScrollViewer>
        <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <StackPanel Margin="32,28" Spacing="20">
                <StackPanel Spacing="12">
                    <Border Classes="emptyIcon" HorizontalAlignment="Left" Width="44" Height="44" CornerRadius="10">
                        <PathIcon Data="{StaticResource Icon.ShieldCheck}" Width="22" Height="22" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Đổi mật khẩu" Classes="h1" FontSize="22" />
                        <TextBlock Text="Mật khẩu mới dùng cho những lần đăng nhập sau." Classes="subtitle" />
                    </StackPanel>
                </StackPanel>

                <Border Classes="alert warning" IsVisible="{Binding IsForced}">
                    <DockPanel>
                        <PathIcon Data="{StaticResource Icon.AlertCircle}" />
                        <TextBlock Text="Bạn đang dùng mật khẩu mặc định. Hãy đặt mật khẩu mới trước khi sử dụng." />
                    </DockPanel>
                </Border>

                <Border Classes="alert error"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <DockPanel>
                        <PathIcon Data="{StaticResource Icon.AlertCircle}" />
                        <TextBlock Text="{Binding ErrorMessage}" />
                    </DockPanel>
                </Border>

                <StackPanel Classes="field">
                    <TextBlock Text="Mật khẩu hiện tại" Classes="label" />
                    <TextBox x:Name="CurrentPasswordBox" Text="{Binding CurrentPassword}" PasswordChar="•"
                             Classes="revealPasswordButton" />
                </StackPanel>
                <StackPanel Classes="field">
                    <TextBlock Text="Mật khẩu mới" Classes="label" />
                    <TextBox Text="{Binding NewPassword}" PasswordChar="•" Classes="revealPasswordButton" />
                    <TextBlock Text="Tối thiểu 8 ký tự, khác mật khẩu hiện tại." Classes="caption" />
                </StackPanel>
                <StackPanel Classes="field">
                    <TextBlock Text="Nhập lại mật khẩu mới" Classes="label" />
                    <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" Classes="revealPasswordButton" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                    <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding CancelCommand}"
                            IsCancel="True">
                        <Panel>
                            <TextBlock Text="Huỷ" IsVisible="{Binding !IsForced}" />
                            <TextBlock Text="Đăng xuất" IsVisible="{Binding IsForced}" />
                        </Panel>
                    </Button>
                    <Button Grid.Column="1" Classes="accent" HorizontalAlignment="Stretch" Content="Lưu mật khẩu"
                            Command="{Binding SaveCommand}" IsDefault="True" />
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
