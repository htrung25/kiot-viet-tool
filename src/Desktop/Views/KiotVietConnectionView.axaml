<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
             x:Class="KiotVietTool.Desktop.Views.KiotVietConnectionView"
             x:DataType="vm:KiotVietConnectionViewModel">
    <ScrollViewer>
        <StackPanel Classes="page" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Kết nối KiotViet" Classes="h1" />
                <TextBlock Text="Kết nối tool với gian hàng KiotViet qua Public API để đồng bộ sản phẩm và bảng giá."
                           Classes="subtitle" />
            </StackPanel>

            <Border Classes="card" Padding="20,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding IsConnected}">
                        <Button Classes="secondary" Command="{Binding SyncCommand}" IsEnabled="{Binding IsIdle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Sync}" />
                                <TextBlock Text="Đồng bộ ngay" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Content="Ngắt kết nối" Foreground="{StaticResource Danger}"
                                Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Classes="emptyIcon" Width="36" Height="36" CornerRadius="8">
                            <PathIcon Data="{StaticResource Icon.Link}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Trạng thái" Classes="label" VerticalAlignment="Center" />
                                <Border Classes="badge success" IsVisible="{Binding IsConnected}">
                                    <TextBlock Text="Đã kết nối" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding !IsConnected}">
                                    <TextBlock Text="Chưa kết nối" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Margin="24,20" Spacing="16">
                    <TextBlock Text="Thông tin kết nối" Classes="h2" FontSize="16" />
                    <Border Classes="alert warning">
                        <DockPanel>
                            <PathIcon Data="{StaticResource Icon.Info}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="Lấy Client ID và Client Secret trên KiotViet: Thiết lập cửa hàng → Thiết lập kết nối API. Gian hàng cần dùng gói có Public API." />
                        </DockPanel>
                    </Border>

                    <Border Classes="alert error"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <DockPanel>
                            <PathIcon Data="{StaticResource Icon.AlertCircle}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Classes="badge success" HorizontalAlignment="Left" Padding="10,6"
                            IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding SuccessMessage}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Classes="field">
                        <TextBlock Text="Retailer (tên gian hàng)" Classes="label" />
                        <TextBox Text="{Binding Retailer}" PlaceholderText="Ví dụ: abc hoặc abc.kiotviet.vn" />
                        <TextBlock Text="Phần tên miền trong địa chỉ abc.kiotviet.vn." Classes="caption" />
                    </StackPanel>
                    <StackPanel Classes="field">
                        <TextBlock Text="Client ID" Classes="label" />
                        <TextBox Text="{Binding ClientId}" />
                    </StackPanel>
                    <StackPanel Classes="field">
                        <TextBlock Text="Client Secret" Classes="label" />
                        <TextBox Text="{Binding ClientSecret}" PasswordChar="•" Classes="revealPasswordButton"
                                 PlaceholderText="{Binding SecretPlaceholder}" />
                        <TextBlock Text="Được mã hoá khi lưu và không bao giờ hiển thị lại." Classes="caption" />
                    </StackPanel>

                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                            <Button Classes="secondary" Content="Kiểm tra kết nối" Command="{Binding TestCommand}"
                                    IsEnabled="{Binding IsIdle}" />
                            <Button Classes="accent" Content="Lưu và đồng bộ" Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsIdle}" IsDefault="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsBusy}">
                            <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" />
                            <TextBlock Text="{Binding ProgressText, FallbackValue='Đang xử lý…', TargetNullValue='Đang xử lý…'}"
                                       Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
