<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KiotVietTool.Desktop.Views.MessageDialogWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.Surface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.App}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Classes="secondary" Content="Huỷ" IsCancel="True" IsVisible="False"
                        MinWidth="88" Click="Cancel_Click" />
                <Button x:Name="OkButton" IsDefault="True" MinWidth="88" Click="Ok_Click" />
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*" Margin="24,24,24,22">
            <Border x:Name="IconBadge" Classes="dialogIcon">
                <PathIcon x:Name="KindIcon" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,2,0,0" Spacing="6">
                <TextBlock x:Name="HeadingText" Classes="h2" FontSize="16" />
                <TextBlock x:Name="MessageText" Classes="subtitle" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
