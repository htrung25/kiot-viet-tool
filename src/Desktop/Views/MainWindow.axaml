<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
        x:Class="KiotVietTool.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KiotViet Tool" Width="1200" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Panel>
        <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding !IdleLock.IsLocked}">
            <!-- Sidebar -->
            <Border Classes="sidebar" IsVisible="{Binding ShowChrome}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="20,22,20,28">
                        <Border Classes="logo">
                            <PathIcon Data="{StaticResource Icon.Store}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KiotViet Tool" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource Text.Primary}" />
                            <TextBlock Text="Quản lý cửa hàng" Classes="caption" />
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border.Default}"
                            BorderThickness="0,1,0,0" Padding="12">
                        <Button Classes="userMenu" ToolTip.Tip="Tài khoản">
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                    <MenuItem Header="Đổi mật khẩu" Command="{Binding ChangePasswordCommand}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Lock}" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Đăng xuất" Command="{Binding SignOutCommand}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Logout}" Width="16" Height="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="avatar">
                                    <TextBlock Text="{Binding UserInitial}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="Medium"
                                               Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Quản trị viên" Classes="caption" />
                                </StackPanel>
                                <PathIcon Grid.Column="2" Data="{StaticResource Icon.UnfoldMore}"
                                          Foreground="{StaticResource Text.Subtle}" />
                            </Grid>
                        </Button>
                    </Border>

                    <StackPanel Margin="12,0" Spacing="2">
                        <TextBlock Text="QUẢN LÝ" Classes="navSection" />
                        <Button Classes="navItem" Classes.active="{Binding IsProductsActive}"
                                Command="{Binding OpenProductsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource Icon.Products}" />
                                <TextBlock Text="Sản phẩm" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="navItem" Classes.active="{Binding IsProgramsActive}"
                                Command="{Binding OpenProgramsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource Icon.Tag}" />
                                <TextBlock Text="Chương trình giảm giá" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="HỆ THỐNG" Classes="navSection" Margin="12,16,12,6" />
                        <Button Classes="navItem" Classes.active="{Binding IsConnectionActive}"
                                Command="{Binding OpenConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource Icon.Link}" />
                                <TextBlock Text="Kết nối KiotViet" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="navItem" Classes.active="{Binding IsDiscountFeedActive}"
                                Command="{Binding OpenDiscountFeedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource Icon.Cloud}" />
                                <TextBlock Text="Máy thu ngân" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="navItem" Classes.active="{Binding IsTelegramActive}"
                                Command="{Binding OpenTelegramCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource Icon.Send}" />
                                <TextBlock Text="Kết nối Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Classes="alert warning" Margin="32,20,32,0"
                        IsVisible="{Binding ShowClockWarning}">
                    <DockPanel>
                        <PathIcon Data="{StaticResource Icon.AlertCircle}" />
                        <TextBlock Text="{Binding ClockWarning}" />
                    </DockPanel>
                </Border>
                <ContentControl Content="{Binding Navigation.CurrentViewModel}" />
            </DockPanel>
        </Grid>

        <Border Classes="alert warning" IsVisible="{Binding IdleLock.IsWarning}" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="24,16" MaxWidth="560">
            <DockPanel>
                <PathIcon Data="{StaticResource Icon.Lock}" />
                <TextBlock Text="{Binding IdleLock.WarningText}" />
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding LockScreen}" IsVisible="{Binding IdleLock.IsLocked}" />
    </Panel>
</Window>
