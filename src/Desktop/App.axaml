<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
             xmlns:views="using:KiotVietTool.Desktop.Views"
             x:Class="KiotVietTool.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Colors.axaml" />
                <ResourceInclude Source="/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- ViewModel → View mapping used by INavigationService. Add one line per new screen. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:ChangePasswordViewModel">
            <views:ChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductListViewModel">
            <views:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="vm:KiotVietConnectionViewModel">
            <views:KiotVietConnectionView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiscountProgramListViewModel">
            <views:DiscountProgramListView />
        </DataTemplate>
        <DataTemplate DataType="vm:DiscountProgramEditorViewModel">
            <views:DiscountProgramEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductPickerViewModel">
            <views:ProductPickerView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <!-- Accent drives focus rings, selection and Classes="accent" buttons; keep in sync with Primary in Colors.axaml -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF2563EB" ErrorText="#FFDC2626" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="/Resources/Styles.axaml" />
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource Bg.App}" />
        </Style>
    </Application.Styles>
</Application>
