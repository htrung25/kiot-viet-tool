{
  "Auth": {
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": "admin",
    "IdleLockMinutes": 30,
    "IdleWarningSeconds": 60
  },
  "KiotViet": {
    "TokenUrl": "https://id.kiotviet.vn/connect/token",
    "ApiBaseUrl": "https://public.kiotapi.com",
    "RequestTimeoutSeconds": 30,
    "MaxGetRequestsPerHour": 4500,
    "MaxRetries": 3
  },
  "DiscountFeed": {
    "Url": "https://kiot-viet-discount-feed.huutrung296sb.workers.dev/",
    "WriteToken": "6f40a336f9317b8275317e634f23f8e5f419872919eff5d585ad99cfab63a791",
    "RequestTimeoutSeconds": 20
  },
  "Telegram": {
    "ApiBaseUrl": "https://api.telegram.org",
    "RequestTimeoutSeconds": 20,
    "ProxyUrl": ""
  },
  "Database": {
    "Path": "%LOCALAPPDATA%/KiotVietTool/app.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/KiotVietTool/logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
