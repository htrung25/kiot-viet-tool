<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KiotVietTool.Desktop.ViewModels"
                    xmlns:views="clr-namespace:KiotVietTool.Desktop.Views">
    <!-- ViewModel → View mapping used by INavigationService. Add one line per new screen. -->
    <DataTemplate DataType="{x:Type vm:CustomerListViewModel}">
        <views:CustomerListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CustomerEditViewModel}">
        <views:CustomerEditView />
    </DataTemplate>
</ResourceDictionary>
