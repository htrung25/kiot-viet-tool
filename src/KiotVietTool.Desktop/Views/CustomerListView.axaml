<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
             xmlns:dto="using:KiotVietTool.Application.Features.Customers"
             x:Class="KiotVietTool.Desktop.Views.CustomerListView"
             x:DataType="vm:CustomerListViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Khách hàng" Classes="pageTitle" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Classes="buttons">
                <Button Content="Thêm" Command="{Binding AddCommand}" />
                <Button Content="Sửa" Command="{Binding EditCommand}" />
                <Button Content="Xoá" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Classes="buttons" Margin="8,0,16,0">
                <Button Content="Tìm" Command="{Binding SearchCommand}" />
            </StackPanel>
            <TextBox Text="{Binding Keyword}" PlaceholderText="Tìm theo mã, tên hoặc số điện thoại">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" DoubleTapped="Grid_DoubleTapped">
            <DataGrid.KeyBindings>
                <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
            </DataGrid.KeyBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" x:DataType="dto:CustomerDto" Width="120" />
                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding Name}" x:DataType="dto:CustomerDto" Width="2*" />
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" x:DataType="dto:CustomerDto" Width="130" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" x:DataType="dto:CustomerDto" Width="*" />
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" x:DataType="dto:CustomerDto" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
