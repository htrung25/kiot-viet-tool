<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
             x:Class="KiotVietTool.Desktop.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
    <Border Classes="card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="8">
            <TextBlock Text="Đổi mật khẩu" Classes="pageTitle" />
            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="Mật khẩu hiện tại" />
            <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" />
            <TextBlock Text="Mật khẩu mới (ít nhất 8 ký tự)" Margin="0,4,0,0" />
            <TextBox Text="{Binding NewPassword}" PasswordChar="•" />
            <TextBlock Text="Nhập lại mật khẩu mới" Margin="0,4,0,0" />
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Classes="buttons" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Lưu" Command="{Binding SaveCommand}" IsDefault="True" />
                <Button Content="Huỷ" Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
