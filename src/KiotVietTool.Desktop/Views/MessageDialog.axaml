<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KiotVietTool.Desktop.Views.MessageDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="HeadingText" Classes="dialogHeading" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Classes="buttons" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Không" IsCancel="True" IsVisible="False" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
