<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KiotVietTool.Desktop.ViewModels"
             x:Class="KiotVietTool.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <Border Classes="card" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="8">
            <TextBlock Text="Đăng nhập" Classes="pageTitle" />
            <TextBlock Text="Tên đăng nhập" />
            <TextBox x:Name="UsernameBox" Text="{Binding Username}" />
            <TextBlock Text="Mật khẩu" Margin="0,4,0,0" />
            <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="False" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="Đăng nhập" Command="{Binding SignInCommand}" IsDefault="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
